<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/color_accent</item>
        <item name="android:navigationBarColor">@color/color_primary_dark</item>
        <item name="android:statusBarColor">@color/color_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/color_background</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/color_primary_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/section_spacing</item>
        <item name="android:layout_marginBottom">@dimen/field_spacing</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">@dimen/field_spacing</item>
    </style>

    <style name="PrimaryButton" parent="android:style/Widget.Material.Button.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
